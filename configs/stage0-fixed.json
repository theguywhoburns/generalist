{
  "model": {
    "vocab_size": 256,
    "d_model": 256,
    "n_heads": 4,
    "head_dim": 64,
    "ffn_hidden": 768,
    "max_loops": 8,
    "ponder_weight": 0.001,
    "halt_bias_init": -3.0,
    "conv_tol": 0.001,
    "conv_patience": 2,
    "max_seq_len": 512,
    "n_stages": 4,
    "blocks_per_stage": 1
  },
  "optim": {
    "precond_ewma": 0.95,
    "refresh_every": 32,
    "ridge_mult": 0.2,
    "eps": 1e-8,
    "init_diag": 0.001,
    "ns_steps": 5
  },
  "train": {
    "lr_muon": 0.002,
    "lr_adamw": 0.0003,
    "batch_size": 6,
    "steps": 500,
    "log_every": 50,
    "eval_every": 200,
    "ckpt_every": 100,
    "eval_max_new": 64,
    "seed": 0,
    "ckpt_dir": "checkpoints-fixed",
    "stuck_timeout_secs": 900,
    "eval_start_step": 0,
    "accum_steps": 2,
    "free_schedule": [1.0, 0.5, 0.2],
    "ponder_warmup_steps": 0,
    "shuffle_eval": true
  },
  "experiment": {
    "tasks": ["subst-fst-fixed"],
    "tracks": ["A", "B"],
    "per_cell": 256,
    "seeds": [0, 1, 2],
    "protocol": {
      "k_set": [0],
      "k0_rate": 0.15,
      "corrupt_rate": 0.05,
      "seps": ["->", ":", "=", "|"]
    }
  }
}
