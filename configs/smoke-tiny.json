{
  "_comment": [
    "CPU smoke test: tiny model, tiny pool, 60 steps. Exercises the full path",
    "(generate -> train -> eval -> checkpoint) in seconds on one core. Not a",
    "tuning run; no result from it is meaningful. Constant LRs on purpose -",
    "a schedule over 60 steps is noise.",
    "",
    "max_seq_len is 512, not 256: sequences pad UP to a bucket edge and RoPE",
    "is sized to max_seq_len, so a lower value breaks the moment a prompt",
    "lands in the top band. parity alone never got there, which is why the",
    "loader now rejects max_seq_len below the top bucket outright."
  ],
  "model": {
    "vocab_size": 256,
    "d_model": 32,
    "n_heads": 2,
    "head_dim": 16,
    "ffn_hidden": 64,
    "max_loops": 4,
    "ponder_weight": 0.001,
    "halt_bias_init": -3.0,
    "conv_tol": 0.001,
    "conv_patience": 2,
    "max_seq_len": 512,
    "n_stages": 1,
    "blocks_per_stage": 1
  },
  "optim": {
    "kind": "muon",
    "momentum": 0.95,
    "dampening": 0.0,
    "nesterov": true,
    "ns_steps": 5,
    "adjust_lr_fn": "Original",
    "weight_decay": 0.0
  },
  "stop": { "kind": "act" },
  "train": {
    "lr_muon": { "kind": "constant", "lr": 0.005 },
    "lr_adamw": { "kind": "constant", "lr": 0.001 },
    "batch_size": 8,

    "auto_batch": false,

    "auto_batch_max": 16384,

    "auto_batch_headroom": 0.75,
    "steps": 60,
    "log_every": 10,
    "eval_every": 30,
    "ckpt_every": 500,
    "eval_max_new": 8,
    "seed": 0,
    "ckpt_dir": "checkpoints-smoke-tiny",
    "eval_holdout": 0.25,
    "eval_in_distribution": true,
    "indist_eval_per_cell": 24,
    "max_train_instances": 0,
    "stuck_timeout_secs": 900,
    "eval_start_step": 0,
    "accum_steps": 1,
    "free_schedule": [1.0, 0.5, 0.2],
    "ponder_warmup_steps": 0,
    "shuffle_eval": true
  },
  "experiment": {
    "tasks": ["parity"],
    "tracks": ["A", "B"],
    "per_cell": 32,
    "seeds": [0],
    "protocol": {
      "k_set": [0, 1, 2, 3, 5, 8],
      "k0_rate": 0.15,
      "corrupt_rate": 0.05,
      "seps": ["->", ":", "=", "|"]
    }
  }
}
